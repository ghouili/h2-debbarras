{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev:admin": "vite",
    "dev:api": "npm --prefix api-server run dev",
    "dev": "concurrently -k -n admin,api -c auto \"npm run dev:admin\" \"npm run dev:api\"",
    "build:admin": "tsc -b && vite build",
    "build:api": "npm --prefix api-server run build",
    "build": "npm run build:admin",
    "build:all": "npm run build:admin && npm run build:api",
    "lint": "eslint src shared",
    "preview": "vite preview",
    "db:migrate": "npm --prefix api-server run db:migrate",
    "db:seed": "npm --prefix api-server run db:seed",
    "db:generate": "npm --prefix api-server run db:generate",
    "db:deploy": "npm --prefix api-server run db:deploy",
    "db:reset": "npm --prefix api-server run db:reset",
    "typecheck": "tsc -b --noEmit",
    "test": "npm run lint && npm run typecheck && npm run build",
    "doctor": "npm --prefix api-server run doctor",
    "api:smoke": "npm --prefix api-server run api:smoke"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.62.7",
    "@tanstack/react-table": "^8.20.5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.469.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.30.1",
    "sonner": "^1.7.3",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
